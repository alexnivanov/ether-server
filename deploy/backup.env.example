# Настройки выгрузки бэкапа за пределы сервера (читается scripts/backup.sh).
#
# На сервере: /etc/ether/backup.env, владелец root, режим 0600 — внутри пароли
# доступа к хранилищу. В git не идёт, здесь только образец.
#
#   sudo install -m 600 -o root -g root backup.env.example /etc/ether/backup.env
#   sudo nano /etc/ether/backup.env
#
# Скрипт не знает, куда именно копирует: адрес — в BACKUP_REMOTE, а сам remote
# описан переменными RCLONE_CONFIG_<ИМЯ>_*. Поэтому смена хранилища — правка
# этого файла, и ничего больше. Ниже два готовых варианта: раскомментировать
# нужный.

# ── Шифрование (age) — ОБЯЗАТЕЛЬНО ──
# Копия содержит персональные данные, поэтому шифруется ДО отправки, и на сервере
# лежит только ПУБЛИЧНЫЙ ключ: получивший доступ к серверу не прочитает ни новые
# копии, ни те, что уже в хранилище. Без этой строки выгрузки не будет вовсе —
# скрипт скажет об этом алертом.
#
# Ключи генерируются НА СВОЕЙ машине, не на сервере:
#   age-keygen -o ether-backup.key      # закрытый — в менеджер паролей
#   grep 'public key' ether-backup.key  # публичный (age1...) — сюда
AGE_RECIPIENT=age1...

# ── Сейчас: Google Drive (как у Айды) ──
# Remote GD описан не здесь, а в отдельном конфиге rclone: OAuth-токен Google
# обновляется каждый час, rclone пишет его обратно, а этот файл юниту только для
# чтения. Конфиг — /var/lib/ether/backups/rclone.conf (root, 0600):
#   [GD]
#   type = drive
#   scope = drive.file
#   token = {...}     <- rclone config create gd drive scope=drive.file (на ноутбуке)
# scope drive.file: rclone видит только созданные им файлы, не весь Диск.
RCLONE_CONFIG=/var/lib/ether/backups/rclone.conf
BACKUP_REMOTE=GD:nous-backups/ether

# Яндекс.Диск по WebDAV стоял до 2026-10 и отказал (обрывы загрузки 499, а REST API
# не принимает rclone 1.60 из Debian) — не возвращаться.

# ── Вариант 2: любое S3-совместимое хранилище ──
# Yandex Object Storage, Selectel, MinIO на своём железе (Cloudflare R2 требует карту,
# Backblaze B2 не регистрирует из РФ/КЗ). Отличается только endpoint. Старые
# датированные копии скрипт чистит сам (RETENTION_DAYS, 30 дней).
#BACKUP_REMOTE=S3:ether-backups
#RCLONE_CONFIG_S3_TYPE=s3
#RCLONE_CONFIG_S3_PROVIDER=Cloudflare
#RCLONE_CONFIG_S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
#RCLONE_CONFIG_S3_ACCESS_KEY_ID=
#RCLONE_CONFIG_S3_SECRET_ACCESS_KEY=
#RCLONE_S3_NO_CHECK_BUCKET=true

# ── Сторож «бэкап не прошёл» (healthchecks.io) ──
# Проверка «ether-backup» (период 1 день, grace 2 ч): сигнал в конце каждого успешного
# прогона, нет сигнала сутки — healthchecks.io шлёт алерт. URL секретный: по нему можно
# подделать «всё хорошо».
HC_PING_URL=
