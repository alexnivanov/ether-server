[Unit]
Description=Ether: ежедневный бэкап базы

[Timer]
# Ночью по времени сервера: активность минимальна, снимок не конкурирует с
# записью. Точное время не важно, поэтому не ровно 4:00 — иначе запуск совпал бы
# с любой другой ночной активностью хоста.
OnCalendar=*-*-* 04:17:00
# Если сервер был выключен в момент запуска — догнать после старта. У cron
# пропущенный запуск просто теряется.
Persistent=true
# Небольшой разброс: полезно, если однажды появится второй сервер.
RandomizedDelaySec=5m

[Install]
WantedBy=timers.target
